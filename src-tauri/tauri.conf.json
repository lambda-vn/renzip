{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RenZip",
  "version": "0.1.0",
  "identifier": "com.lambda-vn.renzip",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RenZip",
        "width": 1240,
        "height": 820,
        "minWidth": 940,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (C) 2026 lambda-vn, CeCILL-2.1",
    "shortDescription": "Gestionnaire d'archives Ren'Py (.rpa)",
    "longDescription": "Ouvrir, inspecter, extraire et reconstruire les archives .rpa des visual novels Ren'Py."
  }
}
